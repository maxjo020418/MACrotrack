POSTGRES_DB=macrotrack
POSTGRES_USER=macrotrack
POSTGRES_PASSWORD=replace-with-db-password
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=replace-with-grafana-db-password

COLLECTOR_PORT=8888
COLLECTOR_PUBLIC_PORT=8888
COLLECTOR_LOG_LEVEL=info
COLLECTOR_API_TOKENS=replace-with-device-token

COLLECTOR_AUTH_REQUIRED=true
COLLECTOR_MAX_BODY_BYTES=262144
COLLECTOR_HEX_PREVIEW_BYTES=128
COLLECTOR_LOG_HEADERS=true
COLLECTOR_LOG_RAW_BODY=false

# Schema is created on app startup for the temporary collector deployment.
COLLECTOR_AUTO_CREATE_SCHEMA=true

# Privacy/storage controls.
COLLECTOR_STORE_RAW_BODY=false
COLLECTOR_STORE_RAW_FRAMES=true
COLLECTOR_STORE_RAW_MACS=false
COLLECTOR_STORE_PLAINTEXT_SSIDS=false

COLLECTOR_MAC_HASH_KEY=replace-with-long-random-secret
COLLECTOR_SSID_HASH_KEY=replace-with-another-long-random-secret

GRAFANA_ROOT_URL=https://macrotrack.yeongmin.net/grafana/
GRAFANA_PUBLIC_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
