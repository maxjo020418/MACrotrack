POSTGRES_DB=macrotrack

# Coolify auto-generates SERVICE_USER_* and SERVICE_PASSWORD_* values and reuses
# the same ID across services in this stack. For local compose, fill examples.
SERVICE_USER_POSTGRES=macrotrack
SERVICE_PASSWORD_POSTGRES=replace-with-db-password
SERVICE_USER_GRAFANA_DB=grafana_reader
SERVICE_PASSWORD_GRAFANA_DB=replace-with-grafana-db-password
SERVICE_USER_GRAFANA_ADMIN=admin
SERVICE_PASSWORD_GRAFANA_ADMIN=replace-with-grafana-admin-password
SERVICE_PASSWORD_COLLECTOR_API_TOKEN=replace-with-device-token
SERVICE_PASSWORD_COLLECTOR_MAC_HASH_KEY=replace-with-long-random-secret
SERVICE_PASSWORD_COLLECTOR_SSID_HASH_KEY=replace-with-another-long-random-secret

COLLECTOR_PORT=8888
COLLECTOR_LOG_LEVEL=info

COLLECTOR_AUTH_REQUIRED=true
COLLECTOR_MAX_BODY_BYTES=262144
COLLECTOR_HEX_PREVIEW_BYTES=128
COLLECTOR_LOG_HEADERS=true
COLLECTOR_LOG_RAW_BODY=false

# Schema is created on app startup for the temporary collector deployment.
COLLECTOR_AUTO_CREATE_SCHEMA=true

# Privacy/storage controls.
COLLECTOR_STORE_RAW_BODY=false
COLLECTOR_STORE_RAW_FRAMES=true
COLLECTOR_STORE_RAW_MACS=false
COLLECTOR_STORE_PLAINTEXT_SSIDS=false

GRAFANA_ROOT_URL=https://macrotrack.yeongmin.net/grafana/
