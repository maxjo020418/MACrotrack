COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8080
COLLECTOR_LOG_LEVEL=info

# Comma-separate multiple accepted tokens.
# Must match esp32_sender's API_TOKEN value.
COLLECTOR_API_TOKENS=replace-with-device-token

COLLECTOR_AUTH_REQUIRED=true
COLLECTOR_MAX_BODY_BYTES=262144
COLLECTOR_HEX_PREVIEW_BYTES=128
COLLECTOR_LOG_HEADERS=true
COLLECTOR_LOG_RAW_BODY=false
